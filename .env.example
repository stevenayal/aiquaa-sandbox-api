# Postgres transaction pooler, port 6543, una connection string por rol.
# Ninguno de estos es un secreto de producción real: el blast radius de una
# fuga se limita al schema qa_training y a las api_keys de los alumnos.
#
# FORMATO VERIFICADO (proyecto hocryhxndegslzfiwlnx, incluyendo un test real
# contra el deploy de Vercel):
#
# - USAR EL POOLER, NUNCA LA CONEXIÓN DIRECTA (db.<project-ref>.supabase.co)
#   en producción/serverless. La conexión directa de este proyecto es
#   IPv6-only (sin registro A, solo AAAA) — funciona desde entornos con
#   salida IPv6, pero falla con "getaddrinfo ENOTFOUND" desde Vercel, cuyas
#   funciones serverless no tienen salida IPv6.
# - Host del pooler: "aws-<N>-<region>.pooler.supabase.com" — el número de
#   cluster (N) varía por proyecto, NO asumas que es "aws-0". Para este
#   proyecto es aws-1-us-east-1. Si tu connection string da
#   "tenant/user not found", probá con otro número de cluster o sacá el
#   host exacto de Dashboard -> Project Settings -> Connect -> pestaña
#   "Transaction pooler".
# - Username: a través del pooler compartido, es obligatorio el sufijo
#   "<rol>.<project-ref>" (ej. "qa_reader.hocryhxndegslzfiwlnx"), no el rol
#   pelado.
# - NO agregues "?sslmode=require" a la URL. lib/db.ts ya pasa
#   `ssl: { rejectUnauthorized: false }` al Pool (y además ahora lo
#   sanitiza si igual lo agregás), pero versiones recientes de
#   pg-connection-string tratan "sslmode=require" como alias de
#   "verify-full", que gana sobre esa config y rompe con "self-signed
#   certificate in certificate chain" contra el pooler de Supabase.
#
# PASSWORD: es el password del rol Postgres (el que se define en los
# CREATE ROLE de scripts/setup-db.sql, o el de "postgres" reseteable en
# Project Settings -> Database -> Reset database password). Es un secreto
# DISTINTO de las keys anon/service_role de la API de Supabase -- esas no
# sirven acá, son para el cliente/SDK (PostgREST/Auth), no para conectar
# directo a Postgres.

DATABASE_URL_READER=postgresql://qa_reader.hocryhxndegslzfiwlnx:PASSWORD@aws-1-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL_WRITER=postgresql://qa_writer.hocryhxndegslzfiwlnx:PASSWORD@aws-1-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL_META=postgresql://app_meta.hocryhxndegslzfiwlnx:PASSWORD@aws-1-us-east-1.pooler.supabase.com:6543/postgres

# Solo para uso local con `npm run db:setup` / `npm run db:seed` (rol admin/owner
# del proyecto Supabase). Nunca se usa desde la app desplegada.
DATABASE_URL_ADMIN=postgresql://postgres.hocryhxndegslzfiwlnx:PASSWORD@aws-1-us-east-1.pooler.supabase.com:6543/postgres

# Upstash Redis REST API (para rate limiting)
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxx
