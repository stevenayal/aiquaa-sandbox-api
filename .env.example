# Postgres transaction pooler, port 6543, una connection string por rol.
# Ninguno de estos es un secreto de producción real: el blast radius de una
# fuga se limita al schema qa_training y a las api_keys de los alumnos.
#
# FORMATO VERIFICADO (proyecto hocryhxndegslzfiwlnx): el pooler de
# transacciones responde en el MISMO host que la conexión directa
# (db.<project-ref>.supabase.co), puerto 6543, con el nombre de rol PELADO
# (sin sufijo ".<project-ref>"). Confirmado con una conexión real.
#
# Si tu proyecto usa el pooler compartido "legacy" de Supavisor en cambio
# (host aws-0-<region>.pooler.supabase.com), el username SÍ necesita el
# sufijo "<rol>.<project-ref>" — probá primero el formato de arriba; si da
# "tenant/user not found", es que tu proyecto usa el esquema legacy y hay
# que sacar el host/puerto exactos de Dashboard -> Project Settings ->
# Connect -> pestaña "Transaction pooler".
#
# PASSWORD: es el password del rol Postgres (el que se define en los
# CREATE ROLE de scripts/setup-db.sql, o el de "postgres" reseteable en
# Project Settings -> Database -> Reset database password). Es un secreto
# DISTINTO de las keys anon/service_role de la API de Supabase -- esas no
# sirven acá, son para el cliente/SDK (PostgREST/Auth), no para conectar
# directo a Postgres.

DATABASE_URL_READER=postgresql://qa_reader:PASSWORD@db.hocryhxndegslzfiwlnx.supabase.co:6543/postgres?sslmode=require
DATABASE_URL_WRITER=postgresql://qa_writer:PASSWORD@db.hocryhxndegslzfiwlnx.supabase.co:6543/postgres?sslmode=require
DATABASE_URL_META=postgresql://app_meta:PASSWORD@db.hocryhxndegslzfiwlnx.supabase.co:6543/postgres?sslmode=require

# Solo para uso local con `npm run db:setup` / `npm run db:seed` (rol admin/owner
# del proyecto Supabase). Nunca se usa desde la app desplegada.
DATABASE_URL_ADMIN=postgresql://postgres:PASSWORD@db.hocryhxndegslzfiwlnx.supabase.co:6543/postgres?sslmode=require

# Upstash Redis REST API (para rate limiting)
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxx
