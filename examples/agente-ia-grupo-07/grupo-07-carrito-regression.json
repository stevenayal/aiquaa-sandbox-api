    {
      "name": "G7-02 Checkout 2 items (crea orden, guarda id)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/ordenes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "ordenes"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"usuarioId\":1,\"items\":[{\"producto\":\"Teclado\",\"cantidad\":2,\"precioUnitario\":10.5},{\"producto\":\"Mouse\",\"cantidad\":1,\"precioUnitario\":5.25}]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.test('monto = 26.25', () => pm.expect(Number(j.data.monto)).to.equal(26.25));",
              "pm.test('producto = primer item', () => pm.expect(j.data.producto).to.equal('Teclado'));",
              "pm.test('estado pendiente', () => pm.expect(j.data.estado).to.equal('pendiente'));",
              "pm.test('2 items con subtotales', () => { pm.expect(j.data.items).to.have.length(2); const s=j.data.items.map(i=>Number(i.subtotal)); pm.expect(s[0]).to.equal(21); pm.expect(s[1]).to.equal(5.25); });",
              "pm.collectionVariables.set('ordenId', j.data.id);"
            ]
          }
        }
      ]
    },
