{
  "info": {
    "name": "Grupo 07 - Carrito de Compras (Regression)",
    "description": "Pruebas de regresion BDD para RF-G7-01..05. Ejecutar con Newman contra la API en vivo + DB qa_training.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "apiKey",
      "value": "REEMPLAZAR_CON_API_KEY_VALIDA"
    },
    {
      "key": "ordenId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "G7-01 Listar todas las ordenes (sin filtro)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/ordenes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "ordenes"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('data es arreglo', () => pm.expect(Array.isArray(j.data)).to.be.true);",
              "pm.test('no incluye items en listado', () => { j.data.forEach(o => pm.expect(o).to.not.have.property('items')); });",
              "pm.test('limite 100', () => pm.expect(j.data.length).to.be.at.most(100));"
            ]
          }
        }
      ]
    },
    {
      "name": "G7-01 Filtrar por usuarioId=1",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/ordenes?usuarioId=1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "ordenes"
          ],
          "query": [
            {
              "key": "usuarioId",
              "value": "1"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('todas pertenecen al comprador 1', () => { j.data.forEach(o => pm.expect(o.usuario_id).to.equal(1)); });",
              "pm.test('orden ascendente por id', () => { for (let i=1;i<j.data.length;i++) pm.expect(j.data[i].id).to.be.above(j.data[i-1].id); });"
            ]
          }
        }
      ]
    },
