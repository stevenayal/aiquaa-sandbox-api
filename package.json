{
  "name": "aiquaa-sandbox-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:setup": "psql \"$DATABASE_URL_ADMIN\" -f scripts/setup-db.sql",
    "db:seed": "psql \"$DATABASE_URL_ADMIN\" -f scripts/seed-data.sql",
    "db:setup:v2": "psql \"$DATABASE_URL_ADMIN\" -f scripts/setup-db-v2.sql",
    "db:seed:v2": "psql \"$DATABASE_URL_ADMIN\" -f scripts/seed-data-v2.sql"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "pg": "^8.13.1",
    "node-sql-parser": "^5.3.6",
    "zod": "^3.24.1",
    "@upstash/redis": "^1.34.3",
    "@upstash/ratelimit": "^2.0.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/pg": "^8.11.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "typescript": "^5",
    "vitest": "^2.1.8",
    "dotenv": "^16.4.7"
  }
}
