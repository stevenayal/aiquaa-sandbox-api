    {
      "title": "/api/perf por ruta: volumen, errores y p95",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "description": "",
      "gridPos": {
